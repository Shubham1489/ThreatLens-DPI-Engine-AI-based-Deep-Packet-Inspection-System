# ── ThreatLens Environment Config ───────────────────────────────
# Copy this file to .env and edit as needed.
# All variables have sensible defaults for development.

# ── Capture ──────────────────────────────────────────────────────
# Leave both empty for demo mode (synthetic traffic)
CAPTURE_INTERFACE=
PCAP_FILE=

# ── Server ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ── Security ─────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins (* = allow all)
CORS_ORIGINS=*

# ── Logging ──────────────────────────────────────────────────────
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── Authentication ────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=threatlens123
